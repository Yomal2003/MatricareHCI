# ========================================================
# MatriCare Healthcare Platform — Backend Environment Configuration
# ========================================================

# ----------------- Server Configuration -----------------
PORT=4000
NODE_ENV=development

# ----------------- MongoDB Connection -------------------
# Local MongoDB example: mongodb://127.0.0.1:27017/matricare
# MongoDB Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/matricare?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/matricare?retryWrites=true&w=majority

# ----------------- JWT Authentication -------------------
# Use a strong, unpredictable random string in production (at least 32 characters)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# ----------------- Email Service (Choose A or B) --------
# OPTION A: Gmail SMTP (via Google App Password)
GMAIL_USER=doctor.moh.office@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# OPTION B: Brevo SMTP (formerly Sendinblue - free 300 emails/day)
# If using Brevo, provide these instead of Gmail:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_account_email@gmail.com
# BREVO_SMTP_KEY=xsmtpsib-your-master-smtp-key-here

EMAIL_FROM="MatriCare MOH Office" <doctor.moh.office@gmail.com>

# ----------------- Frontend / Portal URLs ---------------
# URL included in staff onboarding emails for login redirection
APP_LOGIN_URL=http://localhost:3000/login
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,*

# ----------------- Demo / Dev Flags ---------------------
# Allows demo bypass login for testing roles
DEMO_LOGIN=true
DEV_OTP=123456
