# ---------- Server ----------
PORT=4000
NODE_ENV=development

# ---------- MongoDB ----------
# Paste your MongoDB connection string here (MongoDB Atlas or local).
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/matricare?retryWrites=true&w=majority
# Local example: mongodb://127.0.0.1:27017/matricare
MONGODB_URI=

# ---------- Auth ----------
# Use a long random string in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Allows one-tap demo login by role (POST /auth/login { role }). Set to false in production.
DEMO_LOGIN=true

# Fixed OTP used for mother phone login while no SMS gateway is connected.
DEV_OTP=123456

# ---------- CORS ----------
# Comma-separated list, or * for any origin
CORS_ORIGIN=*
